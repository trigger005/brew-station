# Runs on every build (components/web/CMakeLists.txt): adds 1 to the build
# number in build_number.txt (project root, git-ignored) and writes
# build_info.h with it and the build time, for the page's Diagnostics.
# Usage: cmake -DCOUNTER=<file> -DOUT=<header> -P build_info.cmake
set(n 0)
if(EXISTS "${COUNTER}")
    file(READ "${COUNTER}" n)
    string(STRIP "${n}" n)
    if(NOT n MATCHES "^[0-9]+$")
        set(n 0)
    endif()
endif()
math(EXPR n "${n} + 1")
file(WRITE "${COUNTER}" "${n}\n")
string(TIMESTAMP built "%Y-%m-%d %H:%M")
file(WRITE "${OUT}.tmp" "// Generated by tools/build_info.cmake on every build.\n#pragma once\n#define BUILD_NUMBER ${n}\n#define BUILD_TIME \"${built}\"\n")
file(RENAME "${OUT}.tmp" "${OUT}")
message(STATUS "Build number ${n}")
